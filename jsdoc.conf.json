{
  "plugins": [
    "node_modules/@mandolin/jsdoc-plugin-hia-sys/src/index.cjs"
  ],
  "source": {
    "include": [
      "src"
    ],
    "includePattern": ".+\\.js$"
  },
  "opts": {
    "template": "node_modules/@mandolin/jsdoc-theme-hia",
    "destination": "docs/jsdoc",
    "recurse": true,
    "hia": {
      "mode": "standalone",
      "i18n": {
        "enabled": true,
        "defaultLocale": "zh-CN",
        "fallbackLocale": "en",
        "locales": [
          "zh-CN",
          "en"
        ],
        "mode": "runtimeSwitch"
      },
      "integration": {
        "enabled": true,
        "outputFile": "docs/jsdoc/hia-integration.json"
      }
    }
  }
}
